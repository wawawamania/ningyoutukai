{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ningyoutukai-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  // 同一オリジン化: /api/* を api の Worker に転送する(src/worker.ts)。
  // api を先にデプロイしておくこと(無いとデプロイが失敗する)
  "services": [{ "binding": "API", "service": "ningyoutukai-api" }]
}
