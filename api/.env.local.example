# ローカル開発用の環境変数。このファイルを api/.env.local にコピーして使う(.env.local はコミットしない)。
# 読み込みの優先順位: シェルの環境変数 > .env.local > .env(src/lib/load-env.ts)。
# 本番の値は入れない。本番(Workers)のシークレットは `wrangler secret put` で入れる(docs/deploy.md)。

# 開発用の DB(docker compose の dev 用コンテナ。ポート 5434)。テストは、同じコンテナの
# ningyoutukai_test に自動で切り替わる(tests/setup.ts)ので、ここは開発用の DB のままで良い。
DATABASE_URL=postgres://postgres:postgres@localhost:5434/ningyoutukai
# テストの接続先を明示したいときだけ(既定は DATABASE_URL の DB 名に _test を付けたもの。_test で終わらないと中止)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/ningyoutukai_test

# 開発用。`openssl rand -hex 32` で作る(本番とは別の値にする)。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# 開発用の OAuth アプリの値。本番用とは別のアプリを作る(docs/oauth-setup.md)。
# コールバック URL: http://localhost:3001/api/auth/callback/<provider>(github / google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ローカルのメール受信箱 Mailpit(docker compose で起動。画面は http://localhost:8025)。
# 設定されていれば、メールは Mailpit の HTTP API にだけ送られ、外には出ない。Resend より優先。
# NODE_ENV=production では無視される。受信箱を使わず、ログだけにしたいときは空にする。
MAILPIT_URL=http://localhost:8025

# 空のまま。ローカルでは実際にメールを送らない(MAILPIT_URL が空なら、宛先・件名・本文をログに出す)。
# (.env にキーがあっても、ここで空にすれば送らない)
RESEND_API_KEY=
MAIL_FROM=
