# 本番・共通向けの環境変数の見本。このファイルを api/.env にコピーして使う(.env はコミットしない)。
# ローカル開発では、代わりに api/.env.local を使う(見本は .env.local.example)。
# 読み込みの優先順位: シェルの環境変数 > .env.local > .env。.env.local の値が .env より優先される。
# 値はすべて空。説明は、ルートの README.md の「api/.env.local の設定」を見る。
# BETTER_AUTH_SECRET は openssl rand -hex 32 などで生成する(本番では必須)。
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
WEB_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# 案 D(web と api が同じ親ドメインのサブドメイン)のときだけ。例: .example.com。案 S(同一オリジン)では不要。
# COOKIE_DOMAIN=
